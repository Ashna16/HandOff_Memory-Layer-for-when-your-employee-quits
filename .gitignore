# ── Secrets — never commit ───────────────────────────────────────────────────
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
.git-credentials
**/.git-credentials

# ── Dependencies & build output ──────────────────────────────────────────────
node_modules/
**/node_modules/
guild-agent/dist/
guild-agent/agent.js.gz
guild-agent/tsconfig.tsbuildinfo
**/.npmrc

# ── Runtime data (regenerated on every run) ──────────────────────────────────
app/data/replay/*.jsonl
app/data/seed/

# ── Guild agent local metadata ───────────────────────────────────────────────
guild-agent/guild.json
guild-agent/.guild/

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
*.log
.git-bak/
**/.git-bak/
