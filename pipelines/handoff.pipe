{
  "project_id": "handoff-rescue",
  "version": 1,
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "components": [
    {
      "id": "answer_in",
      "provider": "webhook",
      "name": "Exit-interview answer",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": {
        "position": { "x": 40, "y": 240 },
        "measured": { "width": 150, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "grade_prompt",
      "provider": "prompt",
      "name": "Grade & frame",
      "config": {
        "instructions": [
          "You are Handoff's memory. A departing engineer has just answered a question in her exit interview. Decide whether her answer is usable by whoever inherits the system: it must name the actual mechanism or trade-off, not merely assert a conclusion. Then write the durable handover note in the third person, capturing the mechanism she described so the next owner inherits the reasoning and not just the artifact. Two sentences. If the answer is too thin to act on, say plainly what is still unknown and must be asked in the human handover meeting."
        ],
        "parameters": {}
      },
      "input": [
        { "lane": "questions", "from": "answer_in" }
      ],
      "ui": {
        "position": { "x": 300, "y": 240 },
        "measured": { "width": 150, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "distil_note",
      "provider": "llm_openai",
      "name": "Distil handover note",
      "config": {
        "profile": "openai-4o-mini",
        "openai-4o-mini": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}"
        },
        "parameters": {}
      },
      "input": [
        { "lane": "questions", "from": "grade_prompt" }
      ],
      "ui": {
        "position": { "x": 560, "y": 240 },
        "measured": { "width": 150, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "handover_out",
      "provider": "response_answers",
      "name": "Handover note -> memory",
      "config": { "laneName": "answers" },
      "input": [
        { "lane": "answers", "from": "distil_note" }
      ],
      "ui": {
        "position": { "x": 820, "y": 240 },
        "measured": { "width": 150, "height": 66 },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ]
}
