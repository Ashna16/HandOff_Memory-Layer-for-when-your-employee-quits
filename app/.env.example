# Handoff — copy to .env and fill in. .env is gitignored; never commit real keys.

# Reasoning layer (required for grading, pattern extraction, memory chat)
OPENAI_API_KEY=

# FalkorDB — memory layer (local Docker: npm run falkor)
FALKOR_HOST=127.0.0.1
FALKOR_PORT=6379
FALKOR_PASSWORD=

# LaserData / Apache Iggy — stream + context layer
LASER_URL=http://127.0.0.1:3001
LASER_USERNAME=iggy
LASER_PASSWORD=
LASER_API_KEY=
LASER_TENANT_ID=

# RocketRide — orchestration (SDK reads these names)
ROCKETRIDE_APIKEY=
ROCKETRIDE_URI=https://api.rocketride.ai

# Guild — deployed agent + live destinations
JIRA_SITE=your-site.atlassian.net
JIRA_PROJECT=KAN
GUILD_AGENT=handoff-rescuer
GUILD_LIVE_JIRA=off
GUILD_REAL_ASSIGNEE=
GUILD_SLACK_CHANNEL=
GUILD_REAL_EMAIL=
